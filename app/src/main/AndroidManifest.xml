<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        联网权限，只服务于界面里的「检查更新」按钮：用户点一下才去 GitHub 读一次
        releases/latest，比对版本号。没有后台轮询、没有上报。
        挂钩部分（跑在 SystemUI / launcher / system_server 里的代码）完全不联网。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        「运维按钮」用的自有权限。

        图标页上的「清图标缓存 / 重启进程」不是本进程自己完成的：本应用既读不到桌面的
        数据目录，也杀不掉别的进程。是**注入到目标进程里的模块代码**注册了一个动态广播
        接收器，用宿主自己的 UID 去删自己的文件、去 kill 自己（见 IconHooks）。

        动态接收器必须是导出的（发送方是另一个 uid），所以只能靠**权限**把住入口：
        接收端要求调用方持有本权限，而这是 `signature` 级 —— 只有与本 APK 同签名的
        应用能拿到。少了这一道，任何第三方应用发一条
        `com.iamcanincan.opticon.RESTART_SELF` 就能反复杀掉桌面和 SystemUI。

        这里 `<uses-permission>` 自己声明的自己用，安装时自动授予。
    -->
    <permission
        android:name="com.iamcanincan.opticon.permission.PROCESS_CONTROL"
        android:description="@string/permission_process_control_description"
        android:label="@string/permission_process_control_label"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.iamcanincan.opticon.permission.PROCESS_CONTROL" />

    <!--
        纯 LibXposed（现代 API 102）模块，不要放老式 xposed meta-data。

        官方说明（LSPosed wiki · Develop Xposed Modules Using Modern Xposed API）：
          "Modern API does not use metadata anymore as well. Module name uses
           android:label; module description uses android:description; scope list
           uses META-INF/xposed/scope.list; module configuration uses
           META-INF/xposed/module.prop"

        所以四个元数据分别落在：
          - 模块名     -> android:label         （@string/app_name）
          - 模块描述   -> android:description   （@string/xposed_description）
          - 作用域     -> META-INF/xposed/scope.list
          - 模块配置   -> META-INF/xposed/module.prop（含 staticScope=false）
          - Java 入口  -> META-INF/xposed/java_init.list

        老式写法（xposedmodule / xposeddescription / xposedminversion / xposedscope
        等 meta-data，以及 module.prop 里的 description=）是给 API <= 93 的旧框架用的，
        混着放会让管理器把模块当成「兼容模式」处理，作用域列表会退化成列出全部已装应用。
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:theme="@style/Theme.Opticon"
        android:supportsRtl="true"
        tools:targetApi="34">

        <!--
            这个 Activity 让模块有 MAIN + LAUNCHER 入口 —— 没有它模块就是纯后台的，
            桌面上不会出现图标（只能在系统设置的应用列表里看到）。

            它不参与挂钩，只负责显示界面、把用户的选择写进 SharedPreferences。
            加 Activity 不影响模块元数据。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Opticon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            配置通道：把界面里的开关与模式交给被注入到各进程里的模块代码。

            为什么需要它：模块既读不到本应用的私有目录（系统隔离，表现为 ENOENT），
            也用不了 LibXposed 的远程配置 —— 实测部分框架的 getRemotePreferences
            返回空对象、openRemoteFile 找不到任何文件，配置根本传不过去。
            ContentProvider 不依赖框架实现，各框架上都能用。

            安全：只读，且**按调用方包名认自家人**（见 ConfigProvider.isTrustedCaller，
            名单与作用域清单逐条对齐）。不在名单里的应用查它，拿到的是一张开游标。

            ⚠ 这里**刻意不写** android:readPermission。原先写的是
            android.permission.STATUS_BAR（系统签名级），本意是防普通应用偷看，
            实际效果是连自己人都防了：作用域清单里的 wellbeing 并不持有该权限，
            于是它每秒查一次、每次被 SecurityException 挡掉，最后按默认值干活 ——
            界面上把开关关掉对它不生效。真机才看得出来（见 ConfigProvider 的说明）。
            包名白名单已经足够表达「谁能查」这件事，多那道锁只会漏人。

            它不影响模块元数据：作用域仍是 scope.list。
        -->
        <provider
            android:name=".runtime.ConfigProvider"
            android:authorities="com.iamcanincan.opticon.config"
            android:exported="true" />
    </application>
</manifest>
