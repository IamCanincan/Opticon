    <string name="action_clear_launcher">清除缓存并重启桌面</string>
    <string name="restart_title">重启界面进程</string>
    <string name="restart_body">系统界面、设置、分享面板、数字健康这些进程会自己缓存已经画好的图标；重启它们之后，下次打开会用当前设置重新绘制。</string>
    <string name="action_restart_systemui">重启系统界面</string>
    <string name="action_restart_others">重启设置等进程</string>
