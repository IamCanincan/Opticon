    <!-- 隐私：这块信息之前只写在 README 里，界面上也该有一份 -->
    <string name="privacy_title">网络访问与数据上报</string>
    <string name="privacy_body">仅在用户主动点击「检查更新」时建立网络连接；不包含后台轮询、统计上报或广告。注入进程内的挂钩代码不进行网络访问。</string>

    <!-- 关于（分区标题直接复用底栏的 tab_about，免得两处文案不一致被判重复）-->
    <string name="about_version">版本 %1$s · MIT 许可</string>
    <!-- Opti = 优化，con = icon。**三件事**都落在"图标"上（形状、强制取色的剪影、通知里的小图），别写成互不相干的几块功能 -->
    <string name="about_body">源码与文档见 GitHub。Opticon 关注图标显示的三类问题：桌面图标裁切为正圆、强制动态取色下未适配应用的单色剪影，以及通知栏小图标。</string>

    <!-- ============ 「通知」页 ============ -->

    <string name="notify_switch_title">通知小图标修复</string>
    <string name="notify_switch_body">在「功能」页关闭后不再处理任何通知。设置即时生效；切开关会自动重启系统界面，已显示的通知也会重建。</string>
    <!-- 通知页示意卡：左=灰白色块，右=修复后的可辨识图标 -->
    <string name="notify_effect_title">通知小图标示意</string>
    <string name="notify_effect_body">部分通知的小图标在内容区显示为灰白色块；模块按应用图标生成可辨识的剪影。状态栏那排图标与它同源，由系统只取透明度统一着色，所以看不出颜色差别。</string>
    <string name="notify_sample_before_detail">灰白色块</string>
    <string name="notify_sample_after_title">修复后</string>
    <string name="notify_sample_after_detail">可辨识图标</string>

    <string name="notify_scope_title">通知仅需系统界面</string>
    <string name="notify_scope_body">通知图标由系统界面（com.android.systemui）绘制，因此该功能仅需注入该进程；为其他进程配置作用域不影响此项。若未生效，请在框架的模块详情页重新应用作用域并重启设备。</string>

    <string name="notify_verify_title">验证方法</string>
    <string name="notify_verify_body">展开通知栏，检查内容区的小图标：原为灰白色块者，现应可辨识所属应用。状态栏图标由系统统一着色，不适用此判断。\n\n日志确认：出现 patched &lt;包名&gt; 2-&gt;1 表示替换成功；下方命令可复制。</string>
</resources>
