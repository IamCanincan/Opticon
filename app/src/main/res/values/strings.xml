<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Opticon</string>

    <!--
        模块描述，被 AndroidManifest 的 android:description 引用。

        这是 LibXposed（API 102）模块在管理器里显示描述的**唯一**字段：
        管理器读的是 ApplicationInfo.descriptionRes。
        老式写法（xposeddescription meta-data / module.prop 里的 description=）已经不用，
        那是给 API <= 93 的旧框架用的，留着反而让模块变成「兼容模式」。

        长度约定：中文 <= 26 字，太长在模块列表里会占好几行。**现在 19 字**（主人定的：压回约定内，
        不钉死版本号那类信息也不放进来）。曾经到过 35 字 —— 补上「单色合成」那一路之后没人重新量过长度，
        那条注释还写着"当前 21 字"。**改这一行时必须重新数字**，别相信旁边那句话。
        备选（17 字）：「桌面图标裁圆、取色剪影、通知小图标」。
        三路功能都要提到 —— 用户在 LSPosed 列表里只看得到这一行。
    -->
    <string name="xposed_description">图标裁圆、取色单色剪影、通知小图标修复</string>

    <!--
        自有权限 PROCESS_CONTROL 的名字与说明（出现在系统「设置 → 应用」里）。
        用户不会主动去开它，但文案要能解释清它是干什么的、为什么存在。
    -->
    <string name="permission_process_control_label">Opticon 进程控制</string>
    <string name="permission_process_control_description">只允许 Opticon 自己请求被注入的进程清图标缓存或重启自身</string>

    <!--
        底部导航：图标页（裁圆 + 单色层 + 运维按钮）、通知页、模块页（作用域 / 步骤 / 验证）、关于页（更新 / 版本）。
        四格 —— 三格时药丸太短，撑不起"悬浮药丸"的形态。
    -->
    <string name="tab_icon">图标</string>
    <string name="tab_notify">通知</string>
    <string name="tab_module">模块</string>
    <string name="tab_about">关于</string>

    <!-- ============ 「图标」页 ============ -->


    <!-- 裁圆总开关 -->
    <string name="circle_switch_title">强制圆形图标</string>
    <string name="circle_switch_body">应用图标（含自适应图标）统一裁成正圆；桌面、应用列表、最近任务都生效。</string>

    <!-- 状态卡 -->
    <string name="status_title">模块启用状态</string>
    <string name="status_body">模块在框架中是否启用、作用域是否生效，请到框架管理器里确认。本界面只列出作用域清单和启用步骤。</string>

    <!-- 作用域分组 -->
    <string name="section_scope">作用域</string>
    <string name="scope_hint">图标的两路（裁圆、强制取色的单色合成）都发生在这些进程里 —— 谁解析应用图标，谁就得认得模块打的标记。作用域不写死：任何会显示应用图标的应用都能在管理器里自行勾选；没勾上的进程会拿到无法解析的资源 id。</string>

    <!-- 作用域标签（3 种，多个作用域共享同一档位）-->
    <string name="scope_tag_required">必选</string>
    <string name="scope_tag_recommended">推荐</string>
    <string name="scope_tag_optional">可选</string>

    <!-- 10 个推荐作用域（标题 + 描述 + 标签档位）-->
    <string name="scope_system_title">android（system_server）</string>
    <string name="scope_system_desc">系统服务，解析应用信息</string>

    <string name="scope_systemprocess_title">system</string>
    <string name="scope_systemprocess_desc">系统进程，部分 ROM 在这里解析图标</string>

    <string name="scope_launcher_title">com.android.launcher3</string>
    <string name="scope_launcher_desc">桌面与应用抽屉（类原生 ROM，效果最直观）；Android 16 强制动态取色下，未适配应用的单色图标也在这里修正</string>

    <string name="scope_launcher_pixel_title">com.google.android.apps.nexuslauncher</string>
    <string name="scope_launcher_pixel_desc">桌面与应用抽屉（Pixel / Nexus 专用）；Android 16 强制动态取色下，未适配应用的单色图标也在这里修正</string>

    <string name="scope_systemui_title">com.android.systemui</string>
    <string name="scope_systemui_desc">状态栏与最近任务；通知小图标的修复也在这里</string>

    <string name="scope_settings_title">com.android.settings</string>
    <string name="scope_settings_desc">设置里的应用列表</string>

    <string name="scope_settings_intelligence_title">com.google.android.settings.intelligence</string>
    <string name="scope_settings_intelligence_desc">设置搜索与建议里出现的应用图标</string>

    <string name="scope_intentresolver_title">com.android.intentresolver</string>
    <string name="scope_intentresolver_desc">分享与打开方式的选择列表</string>

    <string name="scope_permissioncontroller_title">com.android.permissioncontroller</string>
    <string name="scope_permissioncontroller_desc">权限弹窗里的应用图标</string>

    <string name="scope_wellbeing_title">com.google.android.apps.wellbeing</string>
    <string name="scope_wellbeing_desc">数字健康的应用使用列表</string>

    <!-- 作用域列表的左右两档（分段按钮）：常用那档只列必选 + 推荐 -->
    <string name="scope_segment_essential">必选 + 推荐</string>
    <string name="scope_segment_all">全部</string>

    <!-- 启用步骤 -->
    <string name="section_steps">启用步骤</string>
    <string name="step_1">在框架中启用本模块</string>
    <string name="step_1_hint">在管理器里把模块开关打开。</string>
    <string name="step_2">按上方清单勾选要生效的进程</string>
    <string name="step_2_hint">至少勾选 com.android.launcher3 才能在桌面看到裁圆与单色层（两路都在桌面进程里）；通知那一路还需要 com.android.systemui。</string>
    <string name="step_3">重启设备</string>
    <string name="step_3_hint">框架不会热加载模块，必须重启。</string>
    <string name="step_4">桌面无变化时，强制停止桌面再打开</string>
    <string name="step_4_hint">刚开机时 daemon 启动晚于 launcher3，进程可能未被注入。</string>

    <!-- 验证 -->
    <string name="section_verify">验证是否生效</string>
    <string name="verify_body">执行下面的命令。看到 install in / Hooked 就说明模块已注入该进程；通知那一路看 patched。</string>
    <string name="verify_logcat">adb logcat -s Opticon</string>
    <string name="verify_copy">复制命令</string>
    <string name="verify_copied">已复制到剪贴板</string>

    <!-- 运维操作：清缓存 / 重启进程（全部由模块在目标进程内部执行，不需要 root） -->
    <string name="section_tools">运维操作</string>
    <string name="tools_body">这些操作由模块在目标进程内部执行，不需要 root，也不会执行 shell 命令。</string>
    <string name="cache_title">清除桌面图标缓存</string>
    <string name="cache_body">桌面把图标位图缓存在自己的数据库里，开关或模块变化后可能不重画。点下面按钮删掉这份缓存并重启桌面；模块自己的剪影缓存会自动作废，不用清。</string>
    <string name="action_clear_launcher">清除缓存并重启桌面</string>
    <string name="action_restart_systemui">重启 SystemUI</string>
    <string name="action_restart_others">重启其他进程</string>
    <string name="cache_sent">已发送：桌面即将重启并重建图标</string>
    <string name="restart_sent">已发送：目标进程即将重启</string>
    <string name="tools_hint">一般只在图标没跟上变化时才点。点了没反应 = 该进程没注入模块，去「模块」页确认作用域。</string>

    <!-- 效果示意（形状对比图）-->
    <string name="section_effect">效果</string>
    <string name="effect_title">统一裁成正圆</string>
    <string name="effect_body">图案铺得满的直接裁成正圆；裁不动的保持完整、缩进圆里并补白底；透明底的快捷方式按原大小铺在白底上。</string>
    <!-- 效果示意四格：标题一行 + 细节一行；原样/裁圆是主对照，裁不动/快捷方式是两档例外 -->
    <string name="effect_sample_original_detail">系统形状</string>
    <string name="effect_sample_cropped_detail">满幅图案</string>
    <string name="effect_sample_shrink_title">裁不动</string>
    <string name="effect_caption_shrink">缩进 + 白底</string>
    <string name="effect_sample_shortcut_title">快捷方式</string>
    <string name="effect_caption_shortcut">原大小 + 白底</string>

    <!--
        单色遮罩极性修正。这条和裁圆是**两个独立开关**：它管的是 Android 16 强制取色下
        桌面替「未适配」应用现场生成的那张单色遮罩，和形状无关。
    -->
    <string name="section_mono">单色图标</string>
    <string name="mono_switch_title">未适配图标：本模块补单色层</string>
    <string name="mono_switch_body">Android 16 强制取色时，给未适配的应用补一张极性正确的剪影。关掉会退回桌面自己的算法，那批图标会整体反色。</string>
    <!-- 效果示意图两块色块下面那行小字：左=系统原样、右=裁完。用短词，别和 effect_title 重复 -->
    <string name="effect_caption_before">原样</string>
    <string name="effect_caption_after">裁圆</string>

    <!-- 说明 -->
    <string name="section_notes">说明</string>
    <string name="note_adaptive">自适应图标也会被强制裁成圆形：系统给它的形状（圆角方、水滴等）不一定是圆。</string>
    <string name="note_tiles">快捷设置磁贴画的是单色小图形，被排除在外。</string>
    <string name="note_mono_cache">剪影按图标内容缓存在桌面自己的缓存目录（上限 48 MB，系统存储紧张时会被清）。换模块版本或图标更新后自动重压，所以升级后第一次重启会慢一些。</string>
    <string name="note_launcher3">Android 16 及以上会关掉桌面自带的背景板；圆形（以及少数图标圆内那层白底）都由模块自己画。</string>
    <string name="note_themed_icon">本 App 图标已提供 monochrome 层，在 Android 13+ 启动器的“主题图标”开关下会染成壁纸取色。</string>

    <!-- 更新卡片 -->
    <string name="section_update">更新</string>
    <!-- 卡片标题和按钮共用这一句 -->
    <string name="update_title">检查更新</string>
    <string name="action_open_repo">在 GitHub 上查看</string>
    <string name="update_current">当前版本 %1$s</string>
    <string name="update_checking">检查中…</string>
    <string name="update_go_download">打开发布页</string>
    <string name="update_disclaimer">只有点下面的按钮才会联网：先直连 GitHub，连不上时走公共加速镜像。
        这是本应用唯一的联网行为，没有统计也没有上报。</string>

    <!-- 更新结果（由 UpdateChecker.Result 翻译成 UpdateState.Done.message）-->
    <string name="update_result_newer">发现新版本 %1$s（当前 %2$s）</string>
    <string name="update_result_uptodate">已是最新版本（%1$s）</string>
    <string name="update_result_uptodate_ahead">已是最新（本地 %1$s 比已发布的 %2$s 还新）</string>
    <string name="update_result_no_release">仓库还没有发布过 Release</string>
    <string name="update_result_failed">检查失败：%1$s</string>

    <!-- 跳转 GitHub 失败（设备上没有能处理 https 的应用）。为什么要有这一条：
         Compose 的 openUri 捕到 ActivityNotFoundException 后会**再抛一个
         IllegalArgumentException**（见 Common.kt 的 openExternalUrl），
         不兜住就是崩应用；兜住了也必须说出来，不能静默什么都不发生。 -->
    <string name="open_link_failed">打不开链接：这台设备上没有能打开网页的应用</string>


    <!-- 隐私：这块信息之前只写在 README 里，界面上也该有一份 -->
    <string name="section_privacy">隐私</string>
    <string name="privacy_title">不联网、不上报</string>
    <string name="privacy_body">只有点「检查更新」时才会联网 —— 没有后台轮询、没有统计上报、没有广告。跑在被注入进程里的挂钩代码完全不联网。</string>

    <!-- 关于（分区标题直接复用底栏的 tab_about，免得两处文案不一致被判重复）-->
    <string name="about_version">版本 %1$s · MIT 许可</string>
    <!-- Opti = 优化，con = icon。**三件事**都落在"图标"上（形状、强制取色的剪影、通知里的小图），别写成互不相干的几块功能 -->
    <string name="about_body">源码与说明在 GitHub。Opticon 就是「优化图标」：桌面上的图标裁圆，强制取色时没做单色适配的应用由本模块补一张极性正确的剪影，通知栏里的小图标修好。</string>

    <!-- ============ 「通知」页 ============ -->

    <string name="notify_switch_title">修复通知小图标</string>
    <string name="notify_switch_desc">关闭后所有通知都不处理</string>

    <string name="notify_status_on">已启用</string>
    <string name="notify_status_off">已停用</string>
    <string name="notify_status_hint">改动立即生效，新收到的通知会按新设置处理；已经在通知栏里的那条要等它重新加载</string>

    <string name="notify_scope_title">关于作用域</string>
    <string name="notify_scope_body">通知由系统界面绘制，所以这一路只需注入 com.android.systemui；额外勾选别的进程不影响它。不生效时，到框架的模块详情页点一次「应用」，再重启设备。</string>

    <string name="notify_verify_title">怎么确认生效</string>
    <string name="notify_verify_body">下拉通知栏看内容区那个小图标：原来是灰白色块的，现在应该能认出是哪个应用。状态栏那一行本来就被系统压成单色，别在那里找差异。\n\n日志确认（adb logcat -s Opticon）：出现 patched &lt;包名&gt; 2-&gt;1 就是替换成功了。</string>
</resources>
