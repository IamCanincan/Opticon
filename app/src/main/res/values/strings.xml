<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Opticon</string>

    <!--
        模块描述，被 AndroidManifest 的 android:description 引用。

        这是 LibXposed（API 102）模块在管理器里显示描述的**唯一**字段：
        管理器读的是 ApplicationInfo.descriptionRes。
        老式写法（xposeddescription meta-data / module.prop 里的 description=）已经不用，
        那是给 API <= 93 的旧框架用的，留着反而让模块变成「兼容模式」。

        长度约定：中文 <= 26 字，太长在模块列表里会占好几行。**现在 19 字**（主人定的：压回约定内，
        不钉死版本号那类信息也不放进来）。曾经到过 35 字 —— 补上「单色合成」那一路之后没人重新量过长度，
        那条注释还写着"当前 21 字"。**改这一行时必须重新数字**，别相信旁边那句话。
        备选（17 字）：「桌面图标裁圆、取色剪影、通知小图标」。
        三路功能都要提到 —— 用户在 LSPosed 列表里只看得到这一行。
    -->
    <string name="xposed_description">图标裁圆、单色剪影、通知小图标修复</string>

    <!--
        自有权限 PROCESS_CONTROL 的名字与说明（出现在系统「设置 → 应用」里）。
        用户不会主动去开它，但文案要能解释清它是干什么的、为什么存在。
    -->
    <string name="permission_process_control_label">Opticon 进程控制</string>
    <string name="permission_process_control_description">仅允许 Opticon 请求已注入进程清除图标缓存或重启自身。</string>

    <!--
        底部导航：三个功能各一页（裁圆 / 单色 / 通知），再加模块（作用域/步骤/验证/运维）
        与关于（更新/版本）。五格 —— 三格时药丸太短，五格仍能一行放下。
    -->
    <string name="tab_crop">裁圆</string>
    <string name="tab_mono">单色</string>
    <string name="tab_notify">通知</string>
    <string name="tab_module">模块</string>
    <string name="tab_about">关于</string>

    <!-- ============ 「图标」页 ============ -->


    <!-- 裁圆总开关 -->
    <string name="circle_switch_title">图标裁切为正圆</string>
    <string name="circle_switch_body">应用图标（含自适应图标）统一裁切为正圆；适用于桌面、应用列表与最近任务。</string>
    <!-- 开关切换后的 Snackbar：桌面有预渲染缓存，需说明清除缓存后才会生效 -->
    <string name="switch_saved_hint">设置已保存。已缓存的桌面图标需在「模块」→「运维操作」中清除桌面缓存后重新生成。</string>

    <!-- 状态卡 -->
    <string name="status_title">模块启用状态</string>
    <string name="status_body">模块的启用状态与作用域生效情况需在框架管理器中确认；本界面仅提供作用域清单与启用步骤。</string>

    <!-- 作用域分组 -->
    <string name="section_scope">作用域</string>
    <string name="scope_hint">图标裁圆与单色合成都发生在这些进程中；解析应用图标的进程需识别模块写入的标记。作用域不固定：显示应用图标的应用均可在框架管理器中勾选；未勾选的进程会收到无法解析的资源 ID。</string>

    <!-- 作用域标签（3 种，多个作用域共享同一档位）-->
    <string name="scope_tag_required">必选</string>
    <string name="scope_tag_recommended">推荐</string>
    <string name="scope_tag_optional">可选</string>
    <string name="scope_copy">复制包名</string>
    <string name="scope_copied">已复制：%1$s</string>

    <!-- 10 个推荐作用域（标题 + 描述 + 标签档位）-->
    <string name="scope_system_title">android（system_server）</string>
    <string name="scope_system_desc">系统服务；解析应用信息。</string>

    <string name="scope_systemprocess_title">system</string>
    <string name="scope_systemprocess_desc">系统进程；部分 ROM 在此解析图标。</string>

    <string name="scope_launcher_title">com.android.launcher3</string>
    <string name="scope_launcher_desc">桌面与应用抽屉（类原生 ROM）；Android 16 强制动态取色下，未适配应用的单色图标亦在此修正。</string>

    <string name="scope_launcher_pixel_title">com.google.android.apps.nexuslauncher</string>
    <string name="scope_launcher_pixel_desc">桌面与应用抽屉（Pixel / Nexus）；Android 16 强制动态取色下，未适配应用的单色图标亦在此修正。</string>

    <string name="scope_systemui_title">com.android.systemui</string>
    <string name="scope_systemui_desc">状态栏与最近任务；通知小图标的修复在此执行。</string>

    <string name="scope_settings_title">com.android.settings</string>
    <string name="scope_settings_desc">设置中的应用列表。</string>

    <string name="scope_settings_intelligence_title">com.google.android.settings.intelligence</string>
    <string name="scope_settings_intelligence_desc">设置搜索与建议中的应用图标。</string>

    <string name="scope_intentresolver_title">com.android.intentresolver</string>
    <string name="scope_intentresolver_desc">分享与打开方式选择列表中的应用图标。</string>

    <string name="scope_permissioncontroller_title">com.android.permissioncontroller</string>
    <string name="scope_permissioncontroller_desc">权限弹窗中的应用图标。</string>

    <string name="scope_wellbeing_title">com.google.android.apps.wellbeing</string>
    <string name="scope_wellbeing_desc">数字健康中的应用使用列表。</string>

    <!-- 作用域列表的左右两档（分段按钮）：常用那档只列必选 + 推荐 -->
    <string name="scope_segment_essential">必选 + 推荐</string>
    <string name="scope_segment_all">全部</string>

    <!-- 启用步骤 -->
    <string name="section_steps">启用步骤</string>
    <string name="step_1">在框架中启用本模块</string>
    <string name="step_1_hint">在框架管理器中启用本模块。</string>
    <string name="step_2">按上方清单选择生效进程</string>
    <string name="step_2_hint">至少选择 com.android.launcher3，方可在桌面观察裁圆与单色层（两者均在桌面进程内执行）；通知功能还需 com.android.systemui。</string>
    <string name="step_3">重启设备</string>
    <string name="step_3_hint">框架不支持模块热加载，需重启设备。</string>
    <string name="step_4">桌面未更新时，强制停止桌面进程并重新启动</string>
    <string name="step_4_hint">设备启动时，框架守护进程可能晚于 launcher3 启动，导致该进程未被注入。</string>

    <!-- 验证 -->
    <string name="section_verify">验证是否生效</string>
    <string name="verify_body">执行下方命令。出现 install in 或 Hooked 表示模块已注入对应进程；通知功能应检查 patched。</string>
    <string name="verify_logcat">adb logcat -s Opticon</string>
    <string name="verify_copy">复制命令</string>
    <string name="verify_copied">已复制到剪贴板</string>

    <!-- 运维操作：清缓存 / 重启进程（全部由模块在目标进程内部执行，不需要 root） -->
    <string name="section_tools">运维操作</string>
    <string name="tools_body">上述操作由模块在目标进程内执行，无需 root 权限，不调用 shell 命令。</string>
    <string name="cache_title">清除桌面图标缓存</string>
    <string name="cache_body">桌面将图标位图缓存于其数据库；开关或模块变更后，缓存可能不会自动更新。点击下方按钮可删除该缓存并重启桌面进程（屏幕会短暂闪烁）。模块的掩码缓存按内容与安装标识自动失效，无需手动清理。</string>
    <string name="action_clear_launcher">清除缓存并重启桌面</string>
    <string name="action_restart_systemui">重启系统界面</string>
    <string name="action_restart_others">重启设置等进程</string>
    <string name="cache_sent">请求已发送：桌面进程将重启，并按当前设置重建图标。</string>
    <string name="restart_sent">请求已发送：目标进程将重启。</string>
    <string name="tools_hint">通常仅在图标未随设置更新时使用。若无响应，表示该进程未注入模块；请核对上方作用域并重启设备。</string>

    <!-- 效果示意（形状对比图）-->
    <string name="section_effect">效果</string>
    <string name="effect_title">统一裁切为正圆</string>
    <string name="effect_body">图案铺满画布的图标直接裁切为正圆；无法裁切的图标保持完整，缩放后置于圆内并补充白色底；透明底快捷方式按原始尺寸置于白色底上。</string>
    <!-- 效果示意四格：标题一行 + 细节一行；原样/正圆是主对照，保留完整/快捷方式是两档例外 -->
    <string name="effect_sample_original_detail">系统形状</string>
    <string name="effect_sample_cropped_detail">满幅图案</string>
    <string name="effect_sample_shrink_title">保留完整</string>
    <string name="effect_caption_shrink">缩放 + 白底</string>
    <string name="effect_sample_shortcut_title">快捷方式</string>
    <string name="effect_caption_shortcut">原始尺寸 + 白底</string>

    <!--
        单色遮罩极性修正。这条和裁圆是**两个独立开关**：它管的是 Android 16 强制取色下
        桌面替「未适配」应用现场生成的那张单色遮罩，和形状无关。2026-10-26 起单色独立成页。
    -->
    <string name="mono_switch_title">未适配图标的单色层</string>
    <string name="mono_switch_body">在 Android 16 强制动态取色下，为未提供单色层的应用生成极性正确的单色剪影。关闭后由桌面自身算法处理，该类图标的明暗关系可能反转。</string>
    <!-- 单色页的示意卡：左=原图标（浅底深形），右=剪影（深形为墨，洞交给桌面主题盘） -->
    <string name="mono_effect_title">单色层示意</string>
    <string name="mono_effect_body">未提供单色层的应用由模块生成剪影：深色图形保留为墨，浅色区域交由桌面主题盘显示。</string>
    <string name="mono_sample_original_title">原图标</string>
    <string name="mono_sample_original_detail">浅底深形</string>
    <string name="mono_sample_silhouette_title">剪影</string>
    <string name="mono_sample_silhouette_detail">深形为墨</string>
    <!-- 效果示意图两块色块下面那行小字：左=系统原样、右=裁切后。用短词，别和 effect_title 重复 -->
    <string name="effect_caption_before">原样</string>
    <string name="effect_caption_after">正圆</string>

    <!-- 说明 -->
    <string name="section_notes">说明</string>
    <string name="note_adaptive">自适应图标同样会被裁切为圆形；系统默认形状（圆角方、水滴等）并非圆形。</string>
    <string name="note_tiles">快速设置磁贴使用单色图形，不在裁切范围内。</string>
    <string name="note_mono_scope">已提供单色层的应用将原样透传，模块不对其像素作修改。</string>
    <string name="note_mono_cache">剪影按图标内容缓存于宿主应用的缓存目录（上限 48 MB，系统存储不足时可能被清除）。模块版本或图标内容变更后缓存自动失效；升级后的首次重启加载会较慢。</string>
    <string name="note_launcher3">Android 16 及以上会禁用桌面自带的背景板；圆形遮罩（以及部分图标圆内的白色底）由模块绘制。</string>
    <string name="note_themed_icon">本应用图标包含 monochrome 层；在 Android 13 及以上启动器启用“主题图标”时，将按壁纸取色渲染。</string>

    <!-- 更新卡片 -->
    <string name="section_update">更新</string>
    <!-- 卡片标题和按钮共用这一句 -->
    <string name="update_title">检查更新</string>
    <string name="action_open_repo">在 GitHub 上查看</string>
    <string name="update_current">当前版本 %1$s</string>
    <string name="update_checking">检查中…</string>
    <string name="update_go_download">打开发布页</string>
    <string name="update_disclaimer">仅当点击下方按钮时建立网络连接：优先直连 GitHub，失败后使用公共镜像。这是本应用唯一的网络行为，不包含统计或上报。</string>

    <!-- 更新结果（由 UpdateChecker.Result 翻译成 UpdateState.Done.message）-->
    <string name="update_result_newer">发现新版本 %1$s（当前 %2$s）。</string>
    <string name="update_result_uptodate">已是最新版本（%1$s）。</string>
    <string name="update_result_uptodate_ahead">当前版本 %1$s 高于已发布版本 %2$s。</string>
    <string name="update_result_no_release">仓库尚无已发布的 Release。</string>
    <string name="update_result_failed">检查失败：%1$s。</string>

    <!-- 跳转 GitHub 失败（设备上没有能处理 https 的应用）。为什么要有这一条：
         Compose 的 openUri 捕到 ActivityNotFoundException 后会**再抛一个
         IllegalArgumentException**（见 Common.kt 的 openExternalUrl），
         不兜住就是崩应用；兜住了也必须说出来，不能静默什么都不发生。 -->
    <string name="open_link_failed">无法打开链接：设备上没有可处理网页的应用。</string>


    <!-- 隐私：这块信息之前只写在 README 里，界面上也该有一份 -->
    <string name="section_privacy">隐私</string>
    <string name="privacy_title">网络访问与数据上报</string>
    <string name="privacy_body">仅在用户主动点击「检查更新」时建立网络连接；不包含后台轮询、统计上报或广告。注入进程内的挂钩代码不进行网络访问。</string>

    <!-- 关于（分区标题直接复用底栏的 tab_about，免得两处文案不一致被判重复）-->
    <string name="about_version">版本 %1$s · MIT 许可</string>
    <!-- Opti = 优化，con = icon。**三件事**都落在"图标"上（形状、强制取色的剪影、通知里的小图），别写成互不相干的几块功能 -->
    <string name="about_body">源码与文档见 GitHub。Opticon 关注图标显示的三类问题：桌面图标裁切为正圆、强制动态取色下未适配应用的单色剪影，以及通知栏小图标。</string>

    <!-- ============ 「通知」页 ============ -->

    <string name="notify_switch_title">通知小图标修复</string>
    <string name="notify_switch_body">关闭后不再处理任何通知。设置即时生效；已显示的通知需重新加载后应用。</string>
    <!-- 通知页示意卡：左=灰白色块，右=修复后的可辨识图标 -->
    <string name="notify_effect_title">通知小图标示意</string>
    <string name="notify_effect_body">部分通知的小图标在内容区显示为灰白色块；模块按应用图标生成可辨识的剪影。状态栏图标由系统统一着色，不在此列。</string>
    <string name="notify_sample_before_detail">灰白色块</string>
    <string name="notify_sample_after_title">修复后</string>
    <string name="notify_sample_after_detail">可辨识图标</string>

    <string name="notify_scope_title">通知仅需系统界面</string>
    <string name="notify_scope_body">通知图标由系统界面（com.android.systemui）绘制，因此该功能仅需注入该进程；为其他进程配置作用域不影响此项。若未生效，请在框架的模块详情页重新应用作用域并重启设备。</string>

    <string name="notify_verify_title">验证方法</string>
    <string name="notify_verify_body">展开通知栏，检查内容区的小图标：原为灰白色块者，现应可辨识所属应用。状态栏图标由系统统一着色，不适用此判断。\n\n日志确认：出现 patched &lt;包名&gt; 2-&gt;1 表示替换成功；下方命令可复制。</string>
</resources>
