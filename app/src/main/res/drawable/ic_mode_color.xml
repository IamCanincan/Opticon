<!--
    「彩色桌面图标」模式的图标：调色盘（外环 + 三个色点）。

    三个点集中在下方弧线上（半径 4.5，左下 / 正下 / 右下），像调色盘的颜料格。
    别把它们摊成三角形 —— 那样在 24dp 下会读成一张脸。

    只描边/填充，颜色写死成黑色 —— 实际颜色由 Compose 的 Icon(tint=...) 决定，
    跟随所在容器的 contentColor。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 外环：两段半圆拼成一个整圆 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,3 A9,9 0 1,1 12,21 A9,9 0 1,1 12,3 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8" />

    <!-- 左下 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M6.4,14.25 A1.7,1.7 0 1,1 9.8,14.25 A1.7,1.7 0 1,1 6.4,14.25 Z" />
    <!-- 正下 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M10.3,16.5 A1.7,1.7 0 1,1 13.7,16.5 A1.7,1.7 0 1,1 10.3,16.5 Z" />
    <!-- 右下 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M14.2,14.25 A1.7,1.7 0 1,1 17.6,14.25 A1.7,1.7 0 1,1 14.2,14.25 Z" />
</vector>
