<!--
    「启用模块」的图标：电源符号（竖线 + 下方约 280° 的圆弧，上方留缺口）。

    圆弧两端在圆心上方左右各 40° 处，圆心 (12,12)、半径 7.2：
      A = (12 - 7.2·sin40°, 12 - 7.2·cos40°) = (7.37, 6.48)
      B = (16.63, 6.48)
    取 largeArc=1 走长的那一边（穿过下方），sweep=0 表示逆时针。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 竖线 -->
    <path
        android:pathData="M12,2.6 L12,11"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />

    <!-- 下方圆弧 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M7.37,6.48 A7.2,7.2 0 1,0 16.63,6.48"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />
</vector>
