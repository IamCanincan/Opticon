<?xml version="1.0" encoding="utf-8"?>
<!--
    图标底板：纯色铺满。

    ⚠ 颜色**不写死**，取 `@color/opticon_icon_background` = 品牌淡粉 `#FCE4EC`，
      全 Android 版本一致、不跟随壁纸取色（早期曾在 API 31+ 改用 system_accent1_100
      跟随壁纸，后按用户要求改回固定淡粉）。所以这个文件本身不含颜色值，改配色去改 colors.xml。

    形状层（圆 / 圆角方 / 水滴）由启动器按自己的 mask 裁，这里只管铺满。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/opticon_icon_background"
        android:pathData="M0,0h108v108h-108z" />
</vector>
