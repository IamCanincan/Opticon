<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+（Android 12+）：图标底板用**系统主题色的淡档**。

    `@android:color/system_accent1_100` 是 Material You tonal palette 里
    最淡的一档（0 = 纯白，1000 = 最深），所以它总是浅的，适合做图标底；
    具体颜色跟随设备的壁纸取色 —— 也就是"淡系统色"。

    这是图标资源能做到的最接近"跟随系统取色"的形式：adaptive icon 的
    背景是静态资源，不能像 Compose 那样在运行期读动态色；
    真正会随主题染色的那层是 monochrome（见 mipmap-anydpi-v33/）。
-->
<resources>
    <color name="opticon_icon_background">@android:color/system_accent1_100</color>
</resources>
